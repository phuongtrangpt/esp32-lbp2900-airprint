{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Viet Phuong Print Connect",
  "version": "1.0.1",
  "identifier": "vn.io.vietphuong.hp-pc-test",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Viet Phuong Print Connect",
        "width": 850,
        "height": 720,
        "minWidth": 650,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "resources/helper/": "helper/",
      "resources/service/hp-pc-service.exe": "hp-pc-service.exe",
      "../install-printer.ps1": "install-printer.ps1"
    },
    "shortDescription": "HP LaserJet P1006 wireless printing with PC rendering and ESP32-S3",
    "licenseFile": "../../../LICENSE",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "perMachine",
        "installerHooks": "installer-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}

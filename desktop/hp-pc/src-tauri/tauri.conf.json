{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HP P1006 PC TEST",
  "version": "0.2.0",
  "identifier": "vn.io.vietphuong.hp-pc-test",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "HP P1006 PC OFFLOAD \u2022 TEST",
        "width": 850,
        "height": 720,
        "minWidth": 650,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "resources/helper/": "helper/",
      "resources/service/hp-pc-service.exe": "hp-pc-service.exe"
    },
    "shortDescription": "Experimental HP P1006 PC rendering and ESP USB transport",
    "licenseFile": "../../../LICENSE",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "perMachine",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
